{
    "name": "n3m3s7s/laravel-eloquent-join",
    "description": "This package introduces the join magic for eloquent models and relations.",
    "keywords": [
        "laravel join",
        "laravel eloquent join",
        "laravel sort join",
        "laravel where join",
        "laravel join relation"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Filip Horvat",
            "email": "filip.horvat@am2studio.hr",
            "homepage": "http://am2studio.hr",
            "role": "Developer"
        },
        {
            "name": "Fabio Politi",
            "email": "fabio.politi.dev@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "illuminate/database": "^5.5|^6.0|^7.0|^8.0|^9.0"
    },
    "require-dev": {
        "orchestra/testbench": "*",
        "friendsofphp/php-cs-fixer" : "*",
        "phpunit/phpunit": "*"
    },
    "autoload": {
        "psr-4": {
            "VertigoStack\\Laravel\\EloquentJoin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VertigoStack\\Laravel\\EloquentJoin\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
